<?xml version="1.0" encoding="utf-8"?>
<!-- Eliza Accessibility loader. Placed next to Eliza.exe, this makes the .NET
     runtime create ElizaAccessBootstrap.Bootstrap (an AppDomainManager) in the
     game process before any game code runs; the bootstrap then starts the mod
     (ElizaAccessDll.dll). Eliza ships no .exe.config of its own, so this file is
     purely additive: delete it to launch the game without the mod. The assembly
     name below must match the built bootstrap exactly — its AssemblyVersion is
     pinned to 1.0.0.0 in Bootstrap/ElizaAccessBootstrap.csproj. -->
<configuration>
  <runtime>
    <appDomainManagerAssembly value="ElizaAccessBootstrap, Version=1.0.0.0, Culture=neutral, PublicKeyToken=null" />
    <appDomainManagerType value="ElizaAccessBootstrap.Bootstrap" />
  </runtime>
</configuration>
