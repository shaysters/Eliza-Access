<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <!-- Keep output at bin\$(Configuration)\net472 even when the environment sets
         Platform (the VS developer prompt sets Platform=x64), so the bundle,
         deploy and release script always find the files they just built. -->
    <AppendPlatformToOutputPath>false</AppendPlatformToOutputPath>
    <OutputType>Library</OutputType>
    <AssemblyName>ElizaAccessDll</AssemblyName>
    <!-- Mod version: the Loadstone release version (build_release.sh reads it). -->
    <Version>0.9.2</Version>
    <!-- The Loadstone submodule and release staging are not part of this project. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);loadstone\**;release\**</DefaultItemExcludes>
    <RootNamespace>ElizaAccess</RootNamespace>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <Optimize>true</Optimize>

    <!--
      Auto-deploy to the game directory after every build.

      GameDir defaults to the standard Steam install path. Override with
      /p:GameDir='<path>' on the command line, or set GameDir as an
      environment variable, when Eliza is installed elsewhere.

      Set /p:SkipDeploy=true to opt out (CI, builds on machines without
      the game installed). Deploy is also auto-skipped if GameDir does
      not exist, so a fresh clone on a non-gaming machine builds cleanly.

      If Eliza.exe is running, the DLL file in the game directory is
      locked and the Copy will fail with a "file in use" error. Close
      the game and re-run.
    -->
    <GameDir Condition="'$(GameDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Eliza</GameDir>
  </PropertyGroup>

  <ItemGroup>
    <!--
      The loader lives in its own project (pinned assembly identity, no
      dependency on this one). Keep its sources out of this assembly and
      build it alongside: ReferenceOutputAssembly=false builds it first
      without referencing it.
    -->
    <Compile Remove="Bootstrap\**" />
    <None Remove="Bootstrap\**" />
    <ProjectReference Include="Bootstrap\ElizaAccessBootstrap.csproj"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

  <PropertyGroup>
    <BootstrapDll>$(MSBuildThisFileDirectory)Bootstrap\bin\$(Configuration)\net472\ElizaAccessBootstrap.dll</BootstrapDll>
    <ExeConfig>$(MSBuildThisFileDirectory)Bootstrap\Eliza.exe.config</ExeConfig>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Lib.Harmony — runtime method patching. Used to hook the game's
      VirtualInput / ScreenStack / IScreen methods so the mod runs in
      response to game events instead of polling.
    -->
    <PackageReference Include="Lib.Harmony" Version="2.3.6" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Localization tables, embedded into the DLL so the mod's spoken
      strings travel with the assembly (no loose data files to deploy
      or lose). Resource names become
      ElizaAccess.Localization.<Language>.ui.json — Loc.cs reads them
      by that path. Edit the JSONs in the repo + rebuild to update.
    -->
    <EmbeddedResource Include="Localization\**\*.json" />
  </ItemGroup>

  <ItemGroup>
    <!--
      prism.dll is the native screen-reader abstraction library
      P/Invoked by SpeechEngine. Vendored from the Prismatoid NuGet
      package's runtimes/win-x64/native/ folder because the managed
      Prismatoid wrapper targets net10.0 only and we're on net472.
    -->
    <None Include="prism.dll" Condition="Exists('prism.dll')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <Target Name="DeployToGameDir" AfterTargets="Build"
          Condition="'$(SkipDeploy)' != 'true' AND Exists('$(GameDir)')">
    <Message Importance="high" Text="Deploying $(AssemblyName).dll to $(GameDir)" />
    <Copy SourceFiles="$(TargetPath)"
          DestinationFolder="$(GameDir)"
          OverwriteReadOnlyFiles="true" />
    <Copy SourceFiles="$(TargetDir)$(AssemblyName).pdb"
          DestinationFolder="$(GameDir)"
          OverwriteReadOnlyFiles="true"
          Condition="Exists('$(TargetDir)$(AssemblyName).pdb')" />
    <!--
      0Harmony.dll is the runtime-patching engine. It must sit next to
      ElizaAccessDll.dll in the game directory so the mod's assembly
      resolver can find it when Main bootstraps Harmony.
    -->
    <Copy SourceFiles="$(TargetDir)0Harmony.dll"
          DestinationFolder="$(GameDir)"
          OverwriteReadOnlyFiles="true"
          Condition="Exists('$(TargetDir)0Harmony.dll')" />
    <!--
      prism.dll is the native screen-reader abstraction library
      P/Invoked from SpeechEngine. Must sit next to ElizaAccessDll.dll
      so the default DLL resolver finds it on first P/Invoke call.
    -->
    <Copy SourceFiles="$(TargetDir)prism.dll"
          DestinationFolder="$(GameDir)"
          OverwriteReadOnlyFiles="true"
          Condition="Exists('$(TargetDir)prism.dll')" />
    <!--
      Loader: Eliza.exe.config makes the .NET runtime create the
      AppDomainManager in ElizaAccessBootstrap.dll, which starts the mod.
    -->
    <Copy SourceFiles="$(BootstrapDll);$(ExeConfig)"
          DestinationFolder="$(GameDir)"
          OverwriteReadOnlyFiles="true" />
  </Target>

  <!--
    Release-build redistributable bundle: every file an end user needs,
    zipped flat so the archive's contents drop straight into the game
    folder. Nothing in it replaces a file the game ships.

    Contents:
      ElizaAccessDll.dll        - the mod (this project's build output)
      0Harmony.dll              - Harmony runtime, from Lib.Harmony NuGet
      prism.dll                 - native screen-reader abstraction
      ElizaAccessBootstrap.dll  - AppDomainManager that loads the mod
      Eliza.exe.config          - tells the .NET runtime to use it

    Set /p:SkipBundle=true to opt out.
  -->
  <Target Name="BundleRelease" AfterTargets="Build"
          Condition="'$(Configuration)' == 'Release' AND '$(SkipBundle)' != 'true'">
    <!-- Evaluate paths inside the target so $(TargetDir) is fully
         resolved by Build's preceding tasks. Using these at property-
         group time gives an empty / project-relative result. -->
    <PropertyGroup>
      <BundleStageDir>$(TargetDir)bundle</BundleStageDir>
      <BundleZipPath>$(TargetDir)ElizaAccess.zip</BundleZipPath>
    </PropertyGroup>
    <Message Importance="high" Text="Bundling release zip → $(BundleZipPath)" />
    <RemoveDir Directories="$(BundleStageDir)" Condition="Exists('$(BundleStageDir)')" />
    <MakeDir Directories="$(BundleStageDir)" />
    <Copy SourceFiles="$(TargetPath);$(TargetDir)0Harmony.dll;$(TargetDir)prism.dll;$(BootstrapDll);$(ExeConfig)"
          DestinationFolder="$(BundleStageDir)" />
    <!-- The user guide, so a downloaded copy can be read offline. It
         lands in the game folder with the rest of the zip, hence the
         prefixed name. -->
    <Copy SourceFiles="$(MSBuildProjectDirectory)\README.md"
          DestinationFiles="$(BundleStageDir)\ElizaAccess-README.md" />
    <Delete Files="$(BundleZipPath)" Condition="Exists('$(BundleZipPath)')" />
    <ZipDirectory SourceDirectory="$(BundleStageDir)"
                  DestinationFile="$(BundleZipPath)" />
  </Target>
</Project>
